{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/x/all",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PAT}"
      }
    },
    "angular": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@angular/cli@21", "mcp"]
    }
  }
}
